[node name="HelpButton" type="Button" parent="MarginContainer/VBoxContainer/TitleRow" unique_id=2052948637]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "HOW TO USE:
1. [Blender Executable] Set the path to your Blender binary (leave empty to use the system PATH version).
2. [Base Model] Select your rigged base character FBX file.
3. [Animations] Click 'Add Animations' to add one or more animation FBX files.
4. [Output] Choose where to save the combined .gltf or .glb file.
5. Click 'Export Combined GLTF' — Blender runs in the background and merges everything.

"
text = "?"
icon = SubResource("DPITexture_ng3op")
flat = true

